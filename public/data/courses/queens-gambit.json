2PP4/2N1PN2/PP3PPP/R2QKB1R w KQ - 3 7","arrows":[],"highlights":[]}],"hints":[],"intro":"Black keeps the pawn and protects d5 with the e-pawn. White just builds up.","type":"explain"},{"id":"03-declined/qgd-main/1","fen":"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1","introArrows":[],"introHighlights":[],"moves":[{"san":"d4","uci":"d2d4","fen":"rnbqkbnr/pppppppp/8/8/3P4/8/PPP1PPPP/RNBQKBNR b KQkq - 0 1","arrows":[],"highlights":[]},{"san":"d5","uci":"d7d5","fen":"rnbqkbnr/ppp1pppp/8/3p4/3P4/8/PPP1PPPP/RNBQKBNR w KQkq - 0 2","arrows":[],"highlights":[]},{"san":"c4","uci":"c2c4","fen":"rnbqkbnr/ppp1pppp/8/3p4/2PP4/8/PP2PPPP/RNBQKBNR b KQkq - 0 2","arrows":[],"highlights":[]},{"san":"e6","uci":"e7e6","fen":"rnbqkbnr/ppp2ppp/4p3/3p4/2PP4/8/PP2PPPP/RNBQKBNR w KQkq - 0 3","arrows":[],"highlights":[]},{"san":"Nc3","uci":"b1c3","fen":"rnbqkbnr/ppp2ppp/4p3/3p4/2PP4/2N5/PP2PPPP/R1BQKBNR b KQkq - 1 3","arrows":[],"highlights":[]},{"san":"Nf6","uci":"g8f6","fen":"rnbqkb1r/ppp2ppp/4pn2/3p4/2PP4/2N5/PP2PPPP/R1BQKBNR w KQkq - 2 4","arrows":[],"highlights":[]},{"san":"Bg5","uci":"c1g5","fen":"rnbqkb1r/ppp2ppp/4pn2/3p2B1/2PP4/2N5/PP2PPPP/R2QKBNR b KQkq - 3 4","arrows":[],"highlights":[]},{"san":"Be7","uci":"f8e7","fen":"rnbqk2r/ppp1bppp/4pn2/3p2B1/2PP4/2N5/PP2PPPP/R2QKBNR w KQkq - 4 5","arrows":[],"highlights":[]},{"san":"e3","uci":"e2e3","fen":"rnbqk2r/ppp1bppp/4pn2/3p2B1/2PP4/2N1P3/PP3PPP/R2QKBNR b KQkq - 0 5","arrows":[],"highlights":[]},{"san":"O-O","uci":"e8g8","fen":"rnbq1rk1/ppp1bppp/4pn2/3p2B1/2PP4/2N1P3/PP3PPP/R2QKBNR w KQ - 1 6","arrows":[],"highlights":[]},{"san":"Nf3","uci":"g1f3","fen":"rnbq1rk1/ppp1bppp/4pn2/3p2B1/2PP4/2N1PN2/PP3PPP/R2QKB1R b KQ - 2 6","arrows":[],"highlights":[]},{"san":"Nbd7","uci":"b8d7","fen":"r1bq1rk1/pppnbppp/4pn2/3p2B1/2PP4/2N1PN2/PP3PPP/R2QKB1R w KQ - 3 7","arrows":[],"highlights":[]}],"hints":["Knight from b1 first, then the bishop from c1.","Support d4 with the e-pawn.","Finish with the g1 knight."],"intro":"Play the main Declined line as White.","type":"line-drill","side":"white"}],"teacherNotes":{"points":["2...e6 is the Queen's Gambit Declined: Black keeps the d5 pawn instead of taking","White has no pawn to win back, so the game is about development and the centre","Main idea: knights out, bishop out, castle","Black's c8 bishop is shut in by the e6 pawn, which is Black's main problem"],"mistakes":["Taking on d5 with the knight when it can be taken back.","Forgetting to castle","Playing e4 too soon without enough support"],"questions":["Which black pawn protects d5 now?","Which black bishop has trouble getting out?","What are White's three jobs?"]}},{"id":"qgd-pin","title":"The pin on the f6 knight","steps":[{"id":"03-declined/qgd-pin/0","fen":"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1","introArrows":[{"color":"R","from":"g5","to":"f6"},{"color":"R","from":"f6","to":"d8"}],"introHighlights":[{"color":"R","square":"f6"},{"color":"G","square":"d8"}],"moves":[{"san":"d4","uci":"d2d4","fen":"rnbqkbnr/pppppppp/8/8/3P4/8/PPP1PPPP/RNBQKBNR b KQkq - 0 1","arrows":[],"highlights":[]},{"san":"d5","uci":"d7d5","fen":"rnbqkbnr/ppp1pppp/8/3p4/3P4/8/PPP1PPPP/RNBQKBNR w KQkq - 0 2","arrows":[],"highlights":[]},{"san":"c4","uci":"c2c4","fen":"rnbqkbnr/ppp1pppp/8/3p4/2PP4/8/PP2PPPP/RNBQKBNR b KQkq - 0 2","arrows":[],"highlights":[]},{"san":"e6","uci":"e7e6","fen":"rnbqkbnr/ppp2ppp/4p3/3p4/2PP4/8/PP2PPPP/RNBQKBNR w KQkq - 0 3","arrows":[],"highlights":[]},{"san":"Nc3","uci":"b1c3","fen":"rnbqkbnr/ppp2ppp/4p3/3p4/2PP4/2N5/PP2PPPP/R1BQKBNR b KQkq - 1 3","arrows":[],"highlights":[]},{"san":"Nf6","uci":"g8f6","fen":"rnbqkb1r/ppp2ppp/4pn2/3p4/2PP4/2N5/PP2PPPP/R1BQKBNR w KQkq - 2 4","arrows":[],"highlights":[]},{"san":"Bg5","uci":"c1g5","fen":"rnbqkb1r/ppp2ppp/4pn2/3p2B1/2PP4/2N5/PP2PPPP/R2QKBNR b KQkq - 3 4","arrows":[{"color":"G","from":"g5","to":"f6"}],"highlights":[],"comment":"The knight usually should not move, or the bishop could take the queen."},{"san":"Be7","uci":"f8e7","fen":"rnbqk2r/ppp1bppp/4pn2/3p2B1/2PP4/2N5/PP2PPPP/R2QKBNR w KQkq - 4 5","arrows":[],"highlights":[{"color":"G","square":"e7"}],"comment":"Black blocks the line with the bishop. The pin is over."}],"hints":[],"intro":"The bishop on g5 attacks the knight on f6. Behind the knight is the queen on d8. This is a pin.","type":"explain"},{"id":"03-declined/qgd-pin/1","fen":"rnbqkb1r/ppp2ppp/4pn2/3p4/2PP4/2N5/PP2PPPP/R1BQKBNR w KQkq - 2 4","introArrows":[],"introHighlights":[],"moves":[{"san":"Bg5","uci":"c1g5","fen":"rnbqkb1r/ppp2ppp/4pn2/3p2B1/2PP4/2N5/PP2PPPP/R2QKBNR b KQkq - 3 4","arrows":[{"color":"G","from":"g5","to":"f6"},{"color":"G","from":"f6","to":"d8"}],"highlights":[],"comment":"The pin on f6."}],"hints":["Use a bishop.","Use the bishop on c1.","Move it to g5 to pin the knight on f6."],"intro":"White to move. Pin the knight on f6 with your dark-squared bishop.","type":"find-move","side":"white"},{"id":"03-declined/qgd-pin/2","fen":"rnbqkb1r/ppp2ppp/4pn2/3p2B1/2PP4/2N5/PP2PPPP/R2QKBNR b KQkq - 3 4","introArrows":[],"introHighlights":[],"moves":[],"hints":[],"intro":"The bishop on g5 attacks the knight on f6, and the queen on d8 stands behind it.","type":"explain"}],"teacherNotes":{"points":["A pin means a piece should not move, because it would expose something more valuable behind it","Here the f6 knight is in front of the queen on d8","This is a pin with the queen behind, not the king. The knight is allowed to move, but usually it should not, because Bxd8 would win the queen. Sometimes moving it wins something even bigger (see the next lesson).","Black usually answers with Be7, which blocks the line and breaks the pin","The bishop can retreat if it is attacked"],"mistakes":["Thinking the pin wins a piece by force. It does not, Black can play Be7","Forgetting to look at what stands behind the pinned piece","Giving the bishop away for the knight too early"],"questions":["What is behind the knight on f6?","What happens if the knight leaves f6?","How can Black break the pin?"]}},